{
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "src": "frontend",
      "use": "@nuxtjs/vercel-builder"
    },
    "backend": {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend"
    }
  ]
}